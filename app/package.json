    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "test:ble-contract": "tsx --tsconfig tsconfig.json scripts/check-ble-contract.mjs",
    "test:ble-readiness": "tsx --tsconfig tsconfig.json scripts/check-ble-readiness.mjs",
    "test:ble-permissions": "tsx --tsconfig tsconfig.json scripts/check-ble-permissions.mjs",
    "test:baseline-acceptance": "tsx --tsconfig tsconfig.json scripts/check-baseline-acceptance.mjs",
    "test:measurement-phase": "tsx --tsconfig tsconfig.json scripts/check-measurement-phase.mjs",
    "test:history-insights": "tsx --tsconfig tsconfig.json scripts/check-history-insights.mjs",
    "test:history-storage": "tsx --tsconfig tsconfig.json scripts/check-history-storage.mjs",
    "test:ble-session-patches": "tsx --tsconfig tsconfig.json scripts/check-ble-session-patches.mjs",
    "test:ble-verification-log": "tsx --tsconfig tsconfig.json scripts/check-ble-verification-log.mjs",
    "test:measurement-format": "tsx --tsconfig tsconfig.json scripts/check-measurement-format.mjs",
    "test:mvp-evidence-template": "tsx --tsconfig tsconfig.json scripts/check-mvp-evidence-template.mjs",
    "test:mvp-run-record": "tsx --tsconfig tsconfig.json scripts/check-mvp-run-record.mjs --self-test",
    "test:mvp-hardware-preflight": "tsx --tsconfig tsconfig.json scripts/check-mvp-hardware-preflight.mjs --self-test",
    "mvp:evidence-template": "tsx --tsconfig tsconfig.json scripts/create-mvp-verification-run.mjs",
    "mvp:evidence-check": "tsx --tsconfig tsconfig.json scripts/check-mvp-run-record.mjs",
    "mvp:hardware-preflight": "tsx --tsconfig tsconfig.json scripts/check-mvp-hardware-preflight.mjs",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write"
  },
