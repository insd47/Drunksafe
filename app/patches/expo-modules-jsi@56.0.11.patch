diff --git a/apple/scripts/build-xcframework.sh b/apple/scripts/build-xcframework.sh
index 7c2587ae2f44066da28a7d57e7d90b9a12926ab2..a9ddbc9ba9e6490d66ba971fc4e11dc60e00ef0b 100755
--- a/apple/scripts/build-xcframework.sh
+++ b/apple/scripts/build-xcframework.sh
@@ -339,7 +339,22 @@ PODS_ROOT="$(cd "$PODS_ROOT" && pwd)"
 #   3. Relative fallback from PODS_ROOT for when `node` isn't on PATH.
 # Forwarded to Package.swift and the modulemap generator below.
 if [[ -n "${REACT_NATIVE_PATH:-}" && -d "${REACT_NATIVE_PATH}" ]]; then
-  RN_ROOT="$(cd "$REACT_NATIVE_PATH" && pwd)"
+  # CocoaPods may receive pnpm's virtual-store path from Expo autolinking.
+  # Prefer the stable top-level symlink only when it resolves to the exact same
+  # package, as it avoids Swift compiler instability on very long virtual-store
+  # paths without crossing React Native versions.
+  NODE_MODULES_RN_ROOT="${PODS_ROOT}/../../node_modules/react-native"
+  if [[ "${REACT_NATIVE_PATH}" == *"/.pnpm/"* && -d "$NODE_MODULES_RN_ROOT" ]]; then
+    REACT_NATIVE_REAL_ROOT="$(cd "$REACT_NATIVE_PATH" && pwd -P)"
+    NODE_MODULES_RN_REAL_ROOT="$(cd "$NODE_MODULES_RN_ROOT" && pwd -P)"
+    if [[ "$REACT_NATIVE_REAL_ROOT" == "$NODE_MODULES_RN_REAL_ROOT" ]]; then
+      RN_ROOT="$(cd "$NODE_MODULES_RN_ROOT" && pwd)"
+    else
+      RN_ROOT="$(cd "$REACT_NATIVE_PATH" && pwd)"
+    fi
+  else
+    RN_ROOT="$(cd "$REACT_NATIVE_PATH" && pwd)"
+  fi
 else
   RN_ROOT="$(node -p 'require("path").dirname(require.resolve("react-native/package.json"))' 2>/dev/null \
     || echo "${PODS_ROOT}/../../node_modules/react-native")"
